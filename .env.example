# Kopiér denne fil til ".env" og udfyld værdierne

# Bot-token fra https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (General Information)
CLIENT_ID=

# Din Discord-servers ID (højreklik på serveren -> Kopiér server-ID)
GUILD_ID=

# Rollen der må tage/færdiggøre/afvise opgaver (udviklerrollen)
DEV_ROLE_ID=

# Kanal hvor loggen skrives (hvem tog sagen, hvem gjorde den færdig, hvad er gjort)
LOG_CHANNEL_ID=

# Kanal hvor nye tickets fra borgere lander som kort udviklerne kan trykke på
REVIEW_CHANNEL_ID=

# ---- Hjemmeside-panel (valgfrit – udelad de tre nedenfor for kun at bruge Discord-panelet) ----

# Client Secret (Discord Developer Portal -> OAuth2 -> Client Secret)
CLIENT_SECRET=

# Hjemmesidens adresse uden skråstreg til sidst, fx https://min-bot.onrender.com eller http://localhost:3000
# Samme adresse + /auth/callback skal tilføjes under OAuth2 -> Redirects i Developer Portal
BASE_URL=

# En lang tilfældig tekst (fx 40+ tegn). Bruges til at sikre login-sessioner.
SESSION_SECRET=

# Port (valgfri – mange værter sætter den selv)
# PORT=3000

# ---- Supabase (anbefalet på Render, så opgaverne overlever genstart) ----
# Kør supabase.sql i Supabase først. Udelad begge for at gemme i en lokal fil.
# Project URL: Supabase -> Project Settings -> API (fx https://abcdxyz.supabase.co)
SUPABASE_URL=
# service_role-nøglen (hemmelig! kun på serveren, aldrig i frontend eller på GitHub)
SUPABASE_SERVICE_KEY=

# Sæt til "off" for at slå selv-ping (anti-søvn på Render) fra
# KEEPALIVE=off
