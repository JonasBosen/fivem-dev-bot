# Kopiér denne fil til ".env" og udfyld værdierne.

# Fra https://discord.com/developers/applications → din app
DISCORD_TOKEN=          # Bot → Reset Token
DISCORD_CLIENT_ID=      # OAuth2 → Client ID
DISCORD_CLIENT_SECRET=  # OAuth2 → Client Secret

# Dashboardets adresse. Tilføj "<BASE_URL>/auth/callback" under OAuth2 → Redirects.
BASE_URL=http://localhost:3000
PORT=3000
# Valgfrit: separat SQLite-database til AllBot. Standard: data/bot.db i dette projekt.
# Ved hosting med persistent disk kan du sætte fx DB_FILE=/var/data/allbot.db.
DB_FILE=
# Online: AllBots eget Supabase-projekt → Connect → Session pooler.
DATABASE_URL=
SESSION_SECRET=skift-mig-til-en-lang-tilfaeldig-tekst

# Valgfrit: Discord bruger-ID'er der må styre ALLE servere botten er på
ADMIN_USER_IDS=

# Valgfrit: server-ID hvor kommandoer registreres med det samme (godt under test)
DEV_GUILD_ID=

# Valgfrit: Twitch-notifikationer (https://dev.twitch.tv/console → Register Your Application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Fælles projekt til ALLE moduler
SUPABASE_PROJECT_REF=kdxxtdiydepuiecpdpha
SUPABASE_URL=https://kdxxtdiydepuiecpdpha.supabase.co
SUPABASE_SERVICE_KEY=
# Eksisterende CLIENT_ID/CLIENT_SECRET accepteres også.

# Ekstra musikbots: én Discord-applikation/token pr. separat musikbot.
# Gentag med bot-ID fra dashboardets Musikbots-fane.
# MUSIC_BOT_123456789012345678_TOKEN=
# MUSIC_BOT_123456789012345678_NAME=Musik 2

# AI til changelog: nøglen sættes kun på Render/backend, aldrig i browseren.
OPENAI_API_KEY=
OPENAI_CHANGELOG_MODEL=gpt-6-luna

# Valgfri AI-model til changelog-billeder
OPENAI_CHANGELOG_IMAGE_MODEL=gpt-image-2.5-flare
